<mvc:View
	controllerName="hw.products.controller.List"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:sfb="sap.ui.comp.smartfilterbar">
	<Page title="간식 목록">
		<content>
			<!-- metadata.xml 을 읽어서 검색 필드를 자동으로 만든다 -->
			<sfb:SmartFilterBar id="smartFilterBar" entitySet="Products" useToolbar="false" search=".onSearch">
				<sfb:controlConfiguration>
					<sfb:ControlConfiguration key="Name" visibleInAdvancedArea="true"/>
					<sfb:ControlConfiguration key="Category" visibleInAdvancedArea="true"/>
				</sfb:controlConfiguration>
			</sfb:SmartFilterBar>

			<!-- product 모델의 /Products 배열을 한 줄씩 반복해서 그린다 -->
			<Table id="productTable" items="{product>/Products}">
				<columns>
					<Column><Text text="ID"/></Column>
					<Column><Text text="제품명"/></Column>
					<Column><Text text="카테고리"/></Column>
					<Column hAlign="End"><Text text="가격"/></Column>
				</columns>
				<items>
					<ColumnListItem type="Navigation" press=".onItemPress">
						<cells>
							<Text text="{product>ProductID}"/>
							<Text text="{product>Name}"/>
							<Text text="{product>Category}"/>
							<Text text="{product>Price}원"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>
